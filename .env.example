# Copy this file to .env if Alice needs environment variables at launch.
# scripts/start.ps1 and scripts/start.sh load simple KEY=VALUE entries without
# evaluating shell expressions. Keep .env private; it may contain credentials.

# The start scripts default this to <project>/.alice-data. Set an absolute path
# to keep Alice's settings, SQLite history, memories, and import Modelfiles
# somewhere else.
# ALICE_HOME=I:\Alice-os\.alice-data

# Provider profiles store only this variable's NAME, never the secret value.
# In Alice's provider settings, set "API key environment variable" to the same
# name (for example, MY_LLM_API_KEY).
# MY_LLM_API_KEY=replace-me

# Optional: required only for private or gated Hugging Face model repositories.
# Alice sends it directly to Hugging Face when you browse/download a GGUF.
# HF_TOKEN=hf_replace_me
