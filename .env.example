# Copy this file to .env if Alice needs environment variables at launch.
# scripts/start.ps1 and scripts/start.sh load simple KEY=VALUE entries without
# evaluating shell expressions. Keep .env private; it may contain credentials.

# First-install setup saves the external storage folder in .alice-install.json.
# Optional override for an existing installation (takes precedence over setup).
# ALICE_HOME=I:\Alice-data

# Provider profiles store only this variable's NAME, never the secret value.
# In Alice's provider settings, set "API key environment variable" to the same
# name (for example, MY_LLM_API_KEY).
# MY_LLM_API_KEY=replace-me

# Optional: required only for private or gated Hugging Face model repositories.
# Alice sends it directly to Hugging Face when you browse/download a GGUF.
# HF_TOKEN=hf_replace_me

# Voice performance/service tuning. Beam size 1 is the faster local default.
# Increase to 3-5 for more recognition accuracy at the cost of CPU latency.
# ALICE_WHISPER_BEAM_SIZE=1
# Smaller models are faster; larger models improve recognition accuracy.
# Supported values: tiny, base, small, medium.
# ALICE_WHISPER_MODEL=base
# Keep the voice worker resident longer to avoid model reloads between sessions.
# Set to 0 to keep it resident until Alice exits.
# ALICE_VOICE_IDLE_SECONDS=300

# Optional: point to a separately installed God's Eye View checkout.
# Otherwise Alice uses tools/gods-eye-view beside the source checkout or EXE.
# ALICE_GODS_EYE_HOME=I:/Alice-os/tools/gods-eye-view

# Optional local CPU speech runtime; defaults to tools/kokoro beside Alice.
# ALICE_KOKORO_HOME=I:/Alice-os/tools/kokoro

# Optional Voicebox runtime and local API. Only loopback HTTP is accepted.
# ALICE_VOICEBOX_HOME=I:/Alice-os/tools/voicebox-runtime
# ALICE_VOICEBOX_URL=http://127.0.0.1:17493
